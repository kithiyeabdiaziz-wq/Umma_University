<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UMMA Library"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearchBooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by title or author..."
        android:inputType="text" />

    <Button
        android:id="@+id/btnMyBorrowedBooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View My Borrowed Books &amp; Fines"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Books:"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
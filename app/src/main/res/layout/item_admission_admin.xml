<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/tvAdmName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Name" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvAdmCourse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Course: ..." android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvAdmStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status: Pending" android:textColor="#FF9800" android:textStyle="bold" android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button android:id="@+id/btnApprove" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Approve" android:backgroundTint="#4CAF50" android:textColor="#FFFFFF" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnReject" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Reject" android:backgroundTint="#F44336" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>